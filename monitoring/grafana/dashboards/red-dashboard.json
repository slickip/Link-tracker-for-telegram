{
  "uid": "link-tracker-red",
  "title": "Link Tracker RED Metrics",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "tags": ["link-tracker", "red"],
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, application)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Service UP",
      "description": "Shows whether bot/scrapper metrics endpoints are available.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{application=~\"$application\"}",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scrapper API request rate",
      "description": "Rate of incoming Scrapper API requests.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (source) (rate(api_requests_total[1m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scrapper request duration p95",
      "description": "95th percentile duration of Scrapper operations.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, scope, scope_type) (rate(request_duration_ms_total_bucket[5m])))",
          "legendFormat": "{{scope}} {{scope_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bot command duration p95",
      "description": "95th percentile duration of Bot command processing.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, scope, scope_type) (rate(command_duration_ms_total_bucket[5m])))",
          "legendFormat": "{{scope}} {{scope_type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory usage",
      "description": "Resident memory usage by application.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{application=~\"$application\"}",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ]
}